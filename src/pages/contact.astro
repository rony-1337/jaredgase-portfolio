---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Jared Gase.">
  <div class="contact-wrap">
    <div class="contact-left">
      <h1>Say hello …</h1>
      <p>
        Thanks for stopping by! Have a question or just want to nerd out about UX?
        I'm always up for a good conversation about design. Drop me a line, I'd love
        to connect.
      </p>

      <hr />

      <address>
        <p>1946 Willis Rd.</p>
        <p>El Cajon, CA. 92020</p>
      </address>

      <div class="contact-details">
        <p>(619) 997-2058</p>
        <p><a href="mailto:jdgase@gmail.com">jdgase@gmail.com</a></p>
      </div>

      <div class="contact-social">
