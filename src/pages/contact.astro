        </a>
      </div>
    </div>

    <div class="contact-right">
      <form name="contact" method="POST" data-netlify="true" action="/contact?success=true">
        <div class="form-field">
          <label for="name">Full name <span class="required">(required)</span></label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-field">
          <label for="email">Email <span class="required">(required)</span></label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-field">
          <label for="message">Message <span class="required">(required)</span></label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>
        <button type="submit" class="submit-btn">Submit</button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .contact-wrap {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 5vmax var(--gutter);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6vw;
    align-items: start;
    min-height: 70vh;
  }

  /* Left */
  .contact-left h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1.25rem;
  }

  .contact-left > p {
    font-size: 0.95rem;
    line-height: 1.7;
    
    margin-bottom: 2rem;
  }

  hr {
    border: none;
    border-top: 1px solid #ccc;
    margin-bottom: 1.5rem;
  }

  address {
    font-style: normal;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .contact-details {
    font-size: 0.95rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .contact-details a {
    color: var(--accent-mid);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.15s;
  }

  .contact-details a:hover { text-decoration-color: var(--accent-mid); }

  .contact-social {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .contact-social a { color: var(--black); transition: opacity 0.15s; }
  .contact-social a:hover { opacity: 0.6; }

  /* Right — form */
  .form-field {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
    font-family: 'Almarai', sans-serif;
  }

  .required {
    color: #666;
    font-weight: 400;
  }

  input, textarea {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 1px solid #ccc;
    border-radius: 2px;
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    background: #f7f7f7;
    color: var(--black);
    transition: border-color 0.15s;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--white);
  }

  textarea { resize: vertical; }

  .submit-btn {
    background: var(--accent);
    color: var(--white);
    border: none;
    padding: 0.75rem 2rem;
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .submit-btn:hover { opacity: 0.85; }

  @media () {
    .contact-wrap { grid-template-columns: 1fr; }
  }
</style>
