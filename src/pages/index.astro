---
import Layout from '../layouts/Layout.astro';

const projects = [
  { slug: 'ai-native-iep',      title: 'Project: AI Native IEP, Putting Tools Into the Workflow',          image: '/images/thumb-ai-native-iep.jpg' },
  { slug: 'agentic-support',    title: 'Case study: Agentic (AI)-Powered Support, Expert to Expert',        image: '/images/thumb-agentic-support.jpg' },
  { slug: 'turbotax-concierge', title: 'Case study: TurboTax Concierge, A New Seller Archetype',            image: '/images/thumb-concierge.jpg' },
  { slug: 'expert-migration',   title: 'Case study: Migration for 30,000+ Product Experts',                 image: '/images/thumb-migration.jpg' },
  { slug: 'cityu-redesign',     title: 'Case study: CityU Website Redesign',                                image: '/images/thumb-cityu.jpg' },
  { slug: 'ux-audit',           title: 'UX Audit: Rethinking the Path to Support',                          image: '/images/thumb-ux-audit.jpg' },
];
---

<Layout title="Home">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-text">
      <p class="greeting">👋 Hi, I'm Jared!</p>
      <h1>I design at the system level.</h1>
      <p class="hero-body">
        I'm a Staff Product Designer at Intuit, leading end-to-end design across sales
        technology and serving as the strategic AI design advisor across sales and customer
        success. My work focuses on connecting workflows, data, and customer journeys into
        AI-native, platform-level systems.
      </p>
      <p class="hero-body">
        Before Intuit, I led experience design across four universities and five affiliates
        at National University System, and earlier I cut my teeth at agency work on
        e-commerce and B2B platforms. The throughline across every chapter: I'm at my best
        when I can shape direction, not just deliver pixels.
      </p>
      <a href="/about" class="btn-primary">Learn more</a>
    </div>
    <div class="hero-image">
      <img
        src="/images/headshot.gif"
        alt="Jared Gase"
      />
      <p class="caption">No, I look like Bob Ross, and no, it's not a wig.</p>
    </div>
  </section>

  <!-- Recent Work -->
  <section class="work-section">
    <div class="work-header">
      <h2>Recent Work</h2>
      <p>A selection of projects where strategy, AI, service design, and platform thinking come together. Each one connects design decisions to business outcomes.</p>
    </div>
    <div class="project-grid">
      {projects.map((p) => (
        <a href={`/work/${p.slug}`} class="project-item">
          <div class="project-image">
            <img src={p.image} alt={p.title} loading="lazy" />
            <div class="project-overlay">
              <span>{p.title}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Get in touch -->
  <section class="cta-section">
    <div class="cta-inner">
      <h2>Get in touch</h2>
      <p>Whether you're here to explore my work or just interested in a good chat about all things design, I'd love to connect. Take a look around and feel free to say hi.</p>
      <a href="/contact" class="btn-outline">Connect with me</a>
    </div>
  </section>

</Layout>

<style>
  /* ─── Hero ─────────────────────────────── */
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 5vmax var(--gutter);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4vw;
    align-items: start;
  }

  .greeting {
    font-size: 1rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .hero-text h1 {
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    color: var(--accent-mid);
    margin-bottom: 1.25rem;
  }

  .hero-body {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .btn-primary {
    display: inline-block;
    margin-top: 1rem;
    background: var(--accent);
    color: var(--white);
    padding: 0.65rem 1.5rem;
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    border-radius: 4px;
    transition: opacity 0.15s;
  }

  .btn-primary:hover { opacity: 0.85; }

  .hero-image img {
    width: 100%;
    border-radius: 4px;
  }

  .caption {
    font-size: 0.78rem;
    color: #888;
    text-align: center;
    margin-top: 0.6rem;
    font-style: italic;
  }

  /* ─── Work section ──────────────────────── */
  .work-section {
    padding: 5vmax var(--gutter);
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .work-header {
    margin-bottom: 2.5rem;
  }

  .work-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    margin-bottom: 0.5rem;
  }

  .work-header p {
    font-size: 0.9rem;
    
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .project-item { display: block; }

  .project-image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #e8e8e8;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .project-item:hover .project-image img {
    transform: scale(1.04);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .project-overlay span {
    font-family: 'Libre Baskerville', serif;
    font-size: clamp(0.9rem, 1.5vw, 1.2rem);
    font-weight: 700;
    color: var(--white);
    text-align: center;
    line-height: 1.3;
  }

  /* ─── CTA section ───────────────────────── */
  .cta-section {
    background: var(--accent);
    color: var(--white);
    padding: 5vmax var(--gutter);
  }

  .cta-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .cta-section h2 {
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    color: var(--white);
    margin-bottom: 0.75rem;
  }

  .cta-section p {
    font-size: 0.95rem;
    
    margin-bottom: 1.75rem;
    opacity: 0.9;
  }

  .btn-outline {
    display: inline-block;
    border: 1px solid var(--white);
    color: var(--white);
    padding: 0.65rem 1.5rem;
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    border-radius: 4px;
    transition: background 0.15s, color 0.15s;
  }

  .btn-outline:hover {
    background: var(--white);
    color: var(--accent);
  }

  /* ─── Responsive ────────────────────────── */
  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; }
    .project-grid { grid-template-columns: 1fr; }
  }
</style>
