---
import Layout from '../layouts/Layout.astro';

const socials = [
  { label: 'LinkedIn',  href: 'https://www.linkedin.com/in/jared-gase/', icon: '/images/icons/linkedin.svg' },
  { label: 'Instagram', href: 'https://www.instagram.com/jared_photo/',  icon: '/images/icons/instagram.png' },
  { label: 'GitHub',    href: 'https://github.com/rony-1337',            icon: '/images/icons/github.svg' },
  { label: 'Dribbble',  href: 'https://dribbble.com/jaredgase',          icon: '/images/icons/dribble.svg' },
];
---

<Layout title="Home">

  <section class="hero">
    <div class="hero-inner">
      <figure class="hero-photo">
        <div class="hero-photo-frame">
          <img src="/images/headshot.gif" alt="Jared Gase" />
        </div>
        <figcaption>Yes, I know I look like Bob Ross, and no, it's not a wig.</figcaption>
      </figure>

      <div class="hero-copy">
        <h1>Jared Gase</h1>

        <p>
          <strong>Staff Product Designer, most recently at Intuit</strong>. I led end to end
          design for the seller experience and served as the AI design advisor across Sales and
          Customer Success, shaping how workflows, data, and customer journeys fit together at
          the platform level.
        </p>

        <p>
          Before that, I led experience design across four universities and five affiliates at
          National University System, after cutting my teeth on agency work in e-commerce and
          B2B. Fifteen years in, I do my best work shaping direction, not just pushing pixels.
          I live in San Diego, and most importantly, I'm a dad of three little boys.
        </p>

        <div class="hero-social">
          {socials.map((s) => (
            <a class="soc-link" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              <span class={`soc-ico soc-${s.label.toLowerCase()}`}></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 6vmax var(--gutter);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 560px);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero-photo { margin: 0; }

  /* Portrait frame — the GIF is natively 3:4, so it fits with no crop */
  .hero-photo-frame {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: 0 30px 60px -30px rgba(20, 40, 60, 0.4);
  }

  .hero-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 0;
    display: block;
  }

  .hero-photo figcaption {
    font-size: 0.78rem;
    color: #888;
    text-align: center;
    margin-top: 0.7rem;
    font-style: italic;
  }

  .hero-copy h1 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    color: var(--accent);
    line-height: 1.1;
    margin-bottom: 1.4rem;
  }

  .hero-copy p {
    font-size: 1rem;
    line-height: 1.7;
    color: #444;
    margin-bottom: 1.1rem;
    max-width: 52ch;
  }

  .hero-copy p strong { color: var(--accent); font-weight: 700; }

  .hero-social {
    display: flex;
    gap: 1.1rem;
    margin-top: 1.6rem;
  }

  .hero-social a { transition: transform 0.18s ease; }
  .hero-social a:hover { transform: translateY(-2px); }
  .hero-social .soc-ico { width: 24px; height: 24px; }

  @media (max-width: 780px) {
    .hero { min-height: 0; padding: 4vmax var(--gutter) 12vmax; }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    /* Full-width square image, caption spans the container */
    .hero-photo { width: 100%; }
    .hero-photo-frame { aspect-ratio: 1 / 1; }
    .hero-photo figcaption { width: 100%; }
    /* Left-aligned copy */
    .hero-copy { text-align: left; }
    .hero-copy p { max-width: none; }
    .hero-social { justify-content: flex-start; }
  }
</style>
