---
import Layout from './Layout.astro';

interface Props {
  title: string;
  type: string;
  timeline: string;
  sector: string;
  role: string;
  platform: string;
  goal: string;
  myImpact: string;
  outcomes: string[];
  image: string;
}

const { title, type, timeline, sector, role, platform, goal, myImpact, outcomes, image } = Astro.props;
---

<Layout title={title} description={goal}>

  <div class="cs-wrap">

    <!-- Back link -->
    <a href="/work" class="cs-back">← Back to work</a>

    <!-- Hero: left = title + meta, right = goal/impact/outcomes -->
    <div class="cs-hero">
      <div class="cs-hero-left">
        <h1>{title}</h1>
        <div class="cs-meta">
          <div><span>Portfolio type</span><span>{type}</span></div>
          <div><span>Project timeline</span><span>{timeline}</span></div>
          <div><span>Sector</span><span>{sector}</span></div>
          <div><span>Role</span><span>{role}</span></div>
          <div><span>Platform</span><span>{platform}</span></div>
        </div>
      </div>
      <div class="cs-hero-right">
        <div class="cs-overview-col">
          <h2 class="cs-overview-heading">Goal</h2>
          <p>{goal}</p>
        </div>
        <div class="cs-overview-col">
          <h2 class="cs-overview-heading">My Impact</h2>
          <p>{myImpact}</p>
        </div>
        <div class="cs-overview-col">
          <h2 class="cs-overview-heading">What I delivered</h2>
          <ul>
            {outcomes.map(o => <li set:html={o}></li>)}
          </ul>
        </div>
      </div>
    </div>

    <!-- Body -->
    <div class="cs-body">
      <slot />
    </div>

    <!-- Bottom nav -->
    <div class="cs-foot">
      <a href="/work" class="cs-back">← Back to work</a>
    </div>

  </div>

</Layout>

<style is:global>
  .cs-wrap {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4vmax var(--gutter) 6vmax;
  }

  /* ── Hero ── */
  .cs-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5vw;
    align-items: start;
    padding-bottom: 4vmax;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 3vmax;
  }

  .cs-hero-left h1 {
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    line-height: 1.15;
    margin-bottom: 1.5rem;
  }

.cs-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cs-meta div {
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .cs-meta div span:first-child {
    font-weight: 700;
    color: #222;
  }

  .cs-meta div span:last-child {
    color: #444;
  }

  /* ── Right: Goal / Impact / Outcomes ── */
  .cs-hero-right {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .cs-overview-heading {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    margin-bottom: 0.75rem;
  }

  .cs-overview-col p,
  .cs-overview-col li {
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .cs-overview-col ul {
    padding-left: 1.25rem;
    margin: 0;
  }

  .cs-overview-col li { margin-bottom: 0.35rem; }

  /* ── Back link ── */
  .cs-back {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--accent);
    margin-bottom: 2.5rem;
    transition: opacity 0.15s;
  }
  .cs-back:hover { opacity: 0.6; }

  /* ── Body ── */
  .cs-body {
    max-width: var(--max-width);
  }

  .cs-foot {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e5e5;
  }

  /* ── Sections ── */
  .cs-section {
    margin-bottom: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid #e5e5e5;
  }
  .cs-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .cs-section-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .cs-section h2 {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    margin-bottom: 1.1rem;
    line-height: 1.25;
  }

  .cs-section h3 {
    font-size: 1rem;
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
  }

  .cs-section h4 {
    font-size: 0.85rem;
    margin-top: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .cs-section p {
    font-size: 0.9rem;
    line-height: 1.75;
    margin-bottom: 0.85rem;
  }

  .cs-section ul,
  .cs-section ol {
    padding-left: 1.25rem;
    font-size: 0.9rem;
    line-height: 1.75;
    margin-bottom: 0.85rem;
  }

  .cs-section li { margin-bottom: 0.35rem; }

  blockquote.cs-ps {
    border-left: 3px solid var(--accent);
    padding: 0.75rem 0 0.75rem 1.25rem;
    margin: 1.25rem 0;
  }

  blockquote.cs-ps p {
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 0.4rem;
    max-width: none;
  }
  blockquote.cs-ps p:last-child { margin-bottom: 0; }

  /* ── Images ── */
  .cs-img {
    margin: 2.5rem 0;
    text-align: center;
  }

  .cs-img img {
    width: 100%;
    max-width: 1000px;
    border-radius: 4px;
    display: block;
    margin: 0 auto;
  }

  .cs-img figcaption {
    font-size: 0.78rem;
    color: #777;
    font-style: italic;
    margin-top: 0.6rem;
    text-align: center;
    line-height: 1.5;
  }

  /* ── Half-size image ── */
  .cs-img-half img {
    max-width: 500px;
  }

  /* ── Video embed ── */
  .cs-video-wrap {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 4px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .cs-video-wrap iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .cs-img-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin: 2.5rem 0;
  }

  .cs-img-2col .cs-img {
    margin: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .cs-hero { grid-template-columns: 1fr; }
    .cs-img-2col { grid-template-columns: 1fr; }
  }
</style>
