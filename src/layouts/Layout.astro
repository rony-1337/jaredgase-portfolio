---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Staff Product Designer at Intuit — designing at the system level." } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>Jared Gase{title !== 'Home' ? ` — ${title}` : ''}</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Almarai:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header id="header">
      <div class="header-inner">
        <a href="/" class="logo-link">
          <img src="/images/jg_icon.webp" alt="Jared Gase" class="nav-logo" />
        </a>
        <nav class="desktop-nav">
          <a href="/about" class:list={[{ active: currentPath.startsWith('/about') }]}>About</a>
          <a href="/work" class:list={[{ active: currentPath.startsWith('/work') }]}>Work</a>
          <a href="/contact" class:list={[{ active: currentPath.startsWith('/contact') }]}>Contact</a>
        </nav>
        <button class="mobile-toggle" id="menuToggle" aria-label="Menu">
          <span></span><span></span>
        </button>
      </div>
      <nav class="mobile-nav" id="mobileNav">
        <a href="/about">About</a>
        <a href="/work">Work</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <main id="page">
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <a href="/" class="footer-logo">
          <img src="/images/jg_icon.webp" alt="Jared Gase" />
        </a>
        <div class="footer-right">
          <div class="footer-social">
            <a href="https://www.linkedin.com/in/jared-gase/" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://www.instagram.com/jared_photo/" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
            </a>
            <a href="https://dribbble.com/jaredgase" target="_blank" rel="noopener" aria-label="Dribbble">
              <svg width="20" height="20" viewBox="0 0 512 512" fill="currentColor"><path d="M256 8C119.252 8 8 119.252 8 256s111.252 248 248 248 248-111.252 248-248S392.748 8 256 8zm163.97 114.366c29.503 36.046 47.369 81.957 47.835 131.955-6.984-1.477-77.018-15.682-147.502-6.818-5.752-14.041-11.181-26.393-18.617-41.614 78.321-31.977 113.818-77.482 118.284-83.523zM396.421 97.87c-3.81 5.427-35.697 48.286-111.021 76.519-34.712-63.776-73.185-116.168-79.04-124.008 67.176-16.193 137.966 1.27 190.061 47.489zm-230.48-33.25c5.585 7.659 43.438 60.116 78.537 122.509-99.087 26.313-186.36 25.934-195.834 25.809C62.38 147.205 106.678 92.573 165.941 64.62zM44.17 256.323c0-2.166.043-4.322.108-6.473 9.268.19 111.92 1.513 217.706-30.146 6.064 11.868 11.857 23.915 17.174 35.949-76.599 21.575-146.194 83.527-180.531 142.306C64.794 360.405 44.17 310.73 44.17 256.323zm81.807 167.113c22.127-45.233 82.178-103.622 167.579-132.756 29.74 77.283 42.039 142.053 45.189 160.638-68.112 29.013-150.015 21.053-212.768-27.882zm248.38 8.489c-2.171-12.886-13.446-74.897-41.152-151.033 66.38-10.626 124.7 6.768 131.947 9.055-9.442 58.941-43.273 109.844-90.795 141.978z"/></svg>
            </a>
          </div>
          <div class="footer-contact">
            <p>(619) 997 - 2058</p>
            <p><a href="mailto:jdgase@gmail.com">jdgase@gmail.com</a></p>
            <p>© {new Date().getFullYear()} Jared Gase</p>
          </div>
        </div>
      </div>
    </footer>

    <script>
      function initPage() {
        // ── Mobile nav toggle ──
        const toggle = document.getElementById('menuToggle');
        const nav = document.getElementById('mobileNav');
        toggle?.addEventListener('click', () => nav?.classList.toggle('open'));

        // ── Apply fade-up to key elements then observe ──
        const fadeTargets = [
          '.cs-section',
          '.cs-img',
          '.project-item',
          '.project-row',
          '.impact-card',
          '.cs-section-label',
          '.hero-text',
          '.hero-image',
          '.work-header',
          '.cta-inner',
          '.resume-block',
        ];
        fadeTargets.forEach(sel => {
          document.querySelectorAll(sel).forEach(el => el.classList.add('fade-up'));
        });

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });

        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

        // ── Typewriter loop on homepage h1 ──
        const h1 = document.querySelector('.hero-headline h1');
        if (h1 && !h1.dataset.typed) {
          h1.dataset.typed = '1';
          const base = 'I design ';
          const phrases = [
            'at the system level.',
            'AI-native experiences.',
            'platforms, not products.',
          ];

          h1.textContent = '';
          h1.style.opacity = '1';

          const textNode = document.createTextNode('');
          const cursor = document.createElement('span');
          cursor.className = 'type-cursor';
          cursor.textContent = '|';
          h1.appendChild(textNode);
          h1.appendChild(cursor);

          let current = '';
          let phraseIndex = 0;

          function type(target, cb) {
            if (current.length < target.length) {
              current = target.slice(0, current.length + 1);
              textNode.textContent = current;
              setTimeout(() => type(target, cb), 70);
            } else { cb(); }
          }

          function erase(target, cb) {
            if (current.length > target.length) {
              current = current.slice(0, -1);
              textNode.textContent = current;
              setTimeout(() => erase(target, cb), 40);
            } else { cb(); }
          }

          function loop() {
            const full = base + phrases[phraseIndex];
            type(full, () => {
              setTimeout(() => {
                erase(base, () => {
                  phraseIndex = (phraseIndex + 1) % phrases.length;
                  setTimeout(loop, 300);
                });
              }, 2500);
            });
          }

          setTimeout(loop, 400);
        }
      }

      // Run on first load and after every ViewTransitions navigation
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --white: #ffffff;
    --black: #000000;
    --accent: hsl(196, 95%, 14.5%);      /* dark teal — nav text, headings */
    --accent-mid: hsl(201, 100%, 34%);   /* medium teal — links, h1 on home */
    --light-bg: hsl(240, 11%, 93%);      /* light gray sections */
    --gutter: 4vw;
    --max-width: 1200px;
  }

  html {
    font-family: 'Almarai', 'Helvetica Neue', Arial, sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: var(--black);
    background: var(--white);
    -webkit-font-smoothing: antialiased;
  }

  body { min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; border-radius: 16px; }
  .nav-logo, .footer-logo img, .impact-icon img, svg { border-radius: 0 !important; }

  /* ── Scroll fade-up ── */
  .fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .fade-up:nth-child(2) { transition-delay: 0.1s; }
  .fade-up:nth-child(3) { transition-delay: 0.2s; }
  .fade-up:nth-child(4) { transition-delay: 0.3s; }
  .fade-up:nth-child(5) { transition-delay: 0.4s; }
  .fade-up:nth-child(6) { transition-delay: 0.5s; }

  /* ── Back link arrow nudge ── */
  .cs-back { transition: transform 0.2s ease, opacity 0.2s ease; }
  .cs-back:hover { transform: translateX(-4px); opacity: 0.7; }

  /* ── Button left-to-right color sweep ── */
  /* Filled buttons — homepage CTA + about resume */
  .btn-primary,
  .btn-view-resume {
    display: inline-block;
    border: 1px solid var(--accent);
    color: var(--white) !important;
    padding: 0.65rem 1.5rem;
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    border-radius: 4px;
    background-color: var(--accent);
    background-image: linear-gradient(to right, rgba(0,0,0,0.28) 50%, rgba(0,0,0,0) 50%);
    background-size: 200% 100%;
    background-position: right center;
    transition: background-position 0.45s ease;
  }
  .btn-primary:hover,
  .btn-view-resume:hover {
    background-position: left center;
    color: var(--white) !important;
  }

  /* Outlined buttons — work page + CTA section */
  .learn-more {
    display: inline-block;
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 0.65rem 1.5rem;
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    border-radius: 4px;
    background-image: linear-gradient(to right, var(--accent) 50%, transparent 50%);
    background-size: 200% 100%;
    background-position: right center;
    transition: background-position 0.45s ease, color 0.45s ease;
  }
  .learn-more:hover { background-position: left center; color: var(--white) !important; }

  .btn-outline {
    display: inline-block;
    border: 1px solid var(--white);
    color: var(--white);
    padding: 0.65rem 1.5rem;
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    border-radius: 4px;
    background-image: linear-gradient(to right, var(--white) 50%, transparent 50%);
    background-size: 200% 100%;
    background-position: right center;
    transition: background-position 0.45s ease, color 0.45s ease;
  }
  .btn-outline:hover { background-position: left center; color: var(--accent) !important; }

  /* ── Typewriter cursor ── */
  .type-cursor {
    display: inline-block;
    color: var(--black);
    font-weight: 400;
    margin-left: 1px;
    animation: blink 0.75s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── Image reveal on scroll ── */
  .cs-img {
    overflow: hidden;
  }
  .cs-img img, .cs-img iframe {
    transition: transform 0.7s ease, opacity 0.7s ease;
  }
  .fade-up .cs-img img {
    transform: scale(1.04);
    opacity: 0.85;
  }
  .fade-up.visible .cs-img img {
    transform: scale(1);
    opacity: 1;
  }

  h1, h2, h3, h4 {
    font-family: 'Libre Baskerville', Georgia, serif;
    line-height: 1.2;
    font-weight: 700;
  }

  /* ─── Header ─────────────────────────────── */
  #header {
    background: var(--white);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo { height: 40px; width: 40px; border-radius: 50%; }

  .desktop-nav { display: flex; gap: 2rem; }

  .desktop-nav a {
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    color: var(--accent);
    letter-spacing: 0.01em;
    transition: opacity 0.15s;
    padding-bottom: 2px;
  }

  .desktop-nav a:hover { opacity: 0.65; }

  .desktop-nav a.active {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-toggle span {
    display: block; width: 22px; height: 1px; background: var(--accent);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem var(--gutter) 1.5rem;
  }

  .mobile-nav.open { display: flex; }
  .mobile-nav a { font-size: 1rem; color: var(--accent); }

  /* ─── Footer ─────────────────────────────── */
  footer {
    border-top: 1px solid #e5e5e5;
    padding: 2rem var(--gutter);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .footer-logo img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
  }

  .footer-right { text-align: right; }

  .footer-social {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    margin-bottom: 0.5rem;
  }

  .footer-social a { color: var(--black); transition: opacity 0.15s; }
  .footer-social a:hover { opacity: 0.6; }

  .footer-contact { font-size: 0.85rem; line-height: 1.8; }
  .footer-contact a { color: var(--accent-mid); }
  .footer-contact a:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .desktop-nav { display: none; }
    .mobile-toggle { display: flex; }
    .footer-inner { align-items: flex-start; }
    .footer-logo img { width: 60px; height: 60px; }
  }
</style>
