---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Staff Product Designer at Intuit — designing at the system level." } = Astro.props;
const currentPath = Astro.url.pathname;

const socials = [
  { label: 'LinkedIn',  href: 'https://www.linkedin.com/in/jared-gase/', icon: '/images/icons/linkedin.svg' },
  { label: 'Instagram', href: 'https://www.instagram.com/jared_photo/',  icon: '/images/icons/instagram.png' },
  { label: 'GitHub',    href: 'https://github.com/rony-1337',            icon: '/images/icons/github.svg' },
  { label: 'Dribbble',  href: 'https://dribbble.com/jaredgase',          icon: '/images/icons/dribble.svg' },
];

const navLinks = [
  { label: 'Work',    href: '/work' },
  { label: 'About',   href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>Jared Gase{title !== 'Home' ? ` — ${title}` : ''}</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Almarai:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header id="header">
      <div class="header-inner">
        <a href="/" class="logo-link">
          <img src="/images/jg_icon.webp" alt="Jared Gase" class="nav-logo" />
        </a>
        <nav class="pill-nav">
          {navLinks.map((l) => (
            <a href={l.href} class:list={[{ active: currentPath.startsWith(l.href) }]}>{l.label}</a>
          ))}
        </nav>
        <div class="nav-social">
          {socials.map((s) => (
            <a class="soc-link" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              <span class={`soc-ico soc-${s.label.toLowerCase()}`}></span>
            </a>
          ))}
        </div>
        <button class="mobile-toggle" id="menuToggle" aria-label="Menu">
          <span></span><span></span>
        </button>
      </div>
      <nav class="mobile-nav" id="mobileNav">
        {navLinks.map((l) => (<a href={l.href}>{l.label}</a>))}
        <div class="mobile-social">
          {socials.map((s) => (
            <a class="soc-link" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              <span class={`soc-ico soc-${s.label.toLowerCase()}`}></span>
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main id="page">
      <slot />
    </main>

    <!-- Site-wide mode toggle FAB. Persists on every page of jaredgase.com (Normal mode).
         "Presentation" jumps to deck.jaredgase.com. -->
    <div class="mode-fab" role="group" aria-label="View mode" transition:persist>
      <span class="mode-seg active" aria-current="true">Normal</span>
      <a class="mode-seg" href="https://deck.jaredgase.com">Presentation</a>
    </div>

    <script>
      function initPage() {
        // ── Mobile nav toggle ──
        const toggle = document.getElementById('menuToggle');
        const nav = document.getElementById('mobileNav');
        toggle?.addEventListener('click', () => nav?.classList.toggle('open'));

        // ── Apply fade-up to key elements then observe ──
        const fadeTargets = [
          '.cs-section',
          '.cs-img',
          '.project-item',
          '.project-row',
          '.impact-card',
          '.cs-section-label',
          '.hero-text',
          '.hero-image',
          '.work-header',
          '.cta-inner',
          '.resume-block',
        ];
        fadeTargets.forEach(sel => {
          document.querySelectorAll(sel).forEach(el => el.classList.add('fade-up'));
        });

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });

        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

        // ── Typewriter loop on homepage h1 ──
        const h1 = document.querySelector('.hero-headline h1');
        if (h1 && !h1.dataset.typed) {
          h1.dataset.typed = '1';
          const base = 'I design ';
          const phrases = [
            'at the system level.',
            'AI-native experiences.',
            'platforms, not products.',
          ];

          h1.textContent = '';
          h1.style.opacity = '1';

          const textNode = document.createTextNode('');
          const cursor = document.createElement('span');
          cursor.className = 'type-cursor';
          cursor.textContent = '|';
          h1.appendChild(textNode);
          h1.appendChild(cursor);

          let current = '';
          let phraseIndex = 0;

          function type(target, cb) {
            if (current.length < target.length) {
              current = target.slice(0, current.length + 1);
              textNode.textContent = current;
              setTimeout(() => type(target, cb), 70);
            } else { cb(); }
          }

          function erase(target, cb) {
            if (current.length > target.length) {
              current = current.slice(0, -1);
              textNode.textContent = current;
              setTimeout(() => erase(target, cb), 40);
            } else { cb(); }
          }

          function loop() {
            const full = base + phrases[phraseIndex];
            type(full, () => {
              setTimeout(() => {
                erase(base, () => {
                  phraseIndex = (phraseIndex + 1) % phrases.length;
                  setTimeout(loop, 300);
                });
              }, 2500);
            });
          }

          setTimeout(loop, 400);
        }
      }

      // Run on first load and after every ViewTransitions navigation
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --white: #ffffff;
    --black: #000000;
    --accent: hsl(196, 95%, 14.5%);      /* dark teal — nav text, headings */
    --accent-mid: hsl(201, 100%, 34%);   /* medium teal — links, h1 on home */
    --brand-blue: #2A88BA;               /* logo blue — toggle active state */
    --light-bg: hsl(240, 11%, 93%);      /* light gray sections */
    --gutter: 4vw;
    --max-width: 1200px;
  }

  /* ── Social icons: black by default, brand color/gradient on hover ──
     Uses each icon as a CSS mask so a single element can be recolored.
     Shared by the header nav and the homepage bio row. */
  .soc-link { display: inline-flex; line-height: 0; }
  .soc-ico {
    display: inline-block;
    width: 20px;
    height: 20px;
    background: #111;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    transition: background 0.2s ease;
  }
  .soc-linkedin  { -webkit-mask-image: url('/images/icons/linkedin.svg');  mask-image: url('/images/icons/linkedin.svg'); }
  .soc-instagram { -webkit-mask-image: url('/images/icons/instagram.png'); mask-image: url('/images/icons/instagram.png'); }
  .soc-github    { -webkit-mask-image: url('/images/icons/github.svg');    mask-image: url('/images/icons/github.svg'); }
  .soc-dribbble  { -webkit-mask-image: url('/images/icons/dribble.svg');   mask-image: url('/images/icons/dribble.svg'); }

  .soc-link:hover .soc-linkedin { background: #0A66C2; }
  .soc-link:hover .soc-github   { background: #4a4a4a; }
  .soc-link:hover .soc-dribbble { background: #EA4C89; }
  .soc-link:hover .soc-instagram {
    background: radial-gradient(circle at 30% 107%,
      #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
  }

  /* ── Site-wide mode toggle FAB (segmented control) ── */
  .mode-fab {
    position: fixed;
    right: clamp(1.25rem, 4vw, 3rem);
    bottom: clamp(1.25rem, 4vw, 2.5rem);
    z-index: 90;
    display: flex;
    gap: 0.2rem;
    padding: 0.3rem;
    background: var(--white);
    border: 1px solid #e5e5e5;
    border-radius: 999px;
    box-shadow: 0 10px 24px -14px rgba(20, 40, 60, 0.4);
  }
  .mode-seg {
    font-family: 'Almarai', sans-serif;
    font-size: 0.8rem;
    color: #666;
    text-decoration: none;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    transition: color 0.18s ease, background 0.18s ease;
  }
  .mode-seg:hover { color: var(--brand-blue); background: hsl(210, 20%, 96%); }
  .mode-seg.active,
  .mode-seg.active:hover {
    color: var(--white);
    background: var(--brand-blue);
  }

  html {
    font-family: 'Almarai', 'Helvetica Neue', Arial, sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: var(--black);
    background: var(--white);
    -webkit-font-smoothing: antialiased;
  }

  body { min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; border-radius: 16px; }
  .nav-logo, .footer-logo img, .impact-icon img, svg { border-radius: 0 !important; }

  /* ── Scroll fade-up ── */
  .fade-up {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .fade-up:nth-child(2) { transition-delay: 0.1s; }
  .fade-up:nth-child(3) { transition-delay: 0.2s; }
  .fade-up:nth-child(4) { transition-delay: 0.3s; }
  .fade-up:nth-child(5) { transition-delay: 0.4s; }
  .fade-up:nth-child(6) { transition-delay: 0.5s; }

  /* ── Back link arrow nudge ── */
  .cs-back { transition: transform 0.2s ease, opacity 0.2s ease; }
  .cs-back:hover { transform: translateX(-4px); opacity: 0.7; }

  /* ── Button left-to-right color sweep ── */
  /* Filled buttons — homepage CTA + about resume */
  .btn-primary,
  .btn-view-resume {
    display: inline-block;
    border: 1px solid var(--accent);
    color: var(--white) !important;
    padding: 0.65rem 1.5rem;
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    border-radius: 4px;
    background-color: var(--accent);
    background-image: linear-gradient(to right, rgba(0,0,0,0.28) 50%, rgba(0,0,0,0) 50%);
    background-size: 200% 100%;
    background-position: right center;
    transition: background-position 0.45s ease;
  }
  .btn-primary:hover,
  .btn-view-resume:hover {
    background-position: left center;
    color: var(--white) !important;
  }

  /* Outlined buttons — work page + CTA section */
  .learn-more {
    display: inline-block;
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 0.65rem 1.5rem;
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    border-radius: 4px;
    background-image: linear-gradient(to right, var(--accent) 50%, transparent 50%);
    background-size: 200% 100%;
    background-position: right center;
    transition: background-position 0.45s ease, color 0.45s ease;
  }
  .learn-more:hover { background-position: left center; color: var(--white) !important; }

  .btn-outline {
    display: inline-block;
    border: 1px solid var(--white);
    color: var(--white);
    padding: 0.65rem 1.5rem;
    font-family: 'Almarai', sans-serif;
    font-size: 0.9rem;
    border-radius: 4px;
    background-image: linear-gradient(to right, var(--white) 50%, transparent 50%);
    background-size: 200% 100%;
    background-position: right center;
    transition: background-position 0.45s ease, color 0.45s ease;
  }
  .btn-outline:hover { background-position: left center; color: var(--accent) !important; }

  /* ── Typewriter cursor ── */
  .type-cursor {
    display: inline-block;
    color: var(--black);
    font-weight: 400;
    margin-left: 1px;
    animation: blink 0.75s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── Image reveal on scroll ── */
  .cs-img {
    overflow: hidden;
  }
  .cs-img img, .cs-img iframe {
    transition: transform 0.7s ease, opacity 0.7s ease;
  }
  .fade-up .cs-img img {
    transform: scale(1.04);
    opacity: 0.85;
  }
  .fade-up.visible .cs-img img {
    transform: scale(1);
    opacity: 1;
  }

  h1, h2, h3, h4 {
    font-family: 'Libre Baskerville', Georgia, serif;
    line-height: 1.2;
    font-weight: 700;
  }

  /* ─── Header ─────────────────────────────── */
  #header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.9rem var(--gutter);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .logo-link { justify-self: start; }
  .nav-logo { height: 40px; width: 40px; border-radius: 50%; }

  /* Centered pill nav */
  .pill-nav {
    justify-self: center;
    display: flex;
    gap: 0.25rem;
    padding: 0.3rem 0.35rem;
    background: var(--white);
    border: 1px solid #e6e6e9;
    border-radius: 999px;
    box-shadow: 0 6px 20px -14px rgba(20, 40, 60, 0.4);
  }

  .pill-nav a {
    font-family: 'Almarai', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.01em;
    color: #5a6b73;
    padding: 0.45rem 1.15rem;
    border-radius: 999px;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .pill-nav a:hover { color: var(--accent); background: hsl(210, 20%, 96%); }

  .pill-nav a.active {
    color: var(--white);
    background: var(--accent);
  }

  /* Social icons (right) */
  .nav-social {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .nav-social a { transition: transform 0.15s; }
  .nav-social a:hover { transform: translateY(-1px); }

  .mobile-toggle {
    display: none;
    justify-self: end;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .mobile-toggle span {
    display: block; width: 22px; height: 1px; background: var(--accent);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem var(--gutter) 1.5rem;
  }

  .mobile-nav.open { display: flex; }
  .mobile-nav a { font-size: 1rem; color: var(--accent); }

  .mobile-social { display: flex; gap: 1.1rem; margin-top: 0.25rem; }
  .mobile-social .soc-ico { width: 22px; height: 22px; }

  @media (max-width: 720px) {
    .header-inner { grid-template-columns: auto 1fr; }
    .pill-nav, .nav-social { display: none; }
    .mobile-toggle { display: flex; }
  }
</style>
